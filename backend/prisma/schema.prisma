generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PasswordResetChannel {
  EMAIL
  SMS
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

//////////////////////////////////////////////////////
// BUSINESS
//////////////////////////////////////////////////////

model Business {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  about                String?
  email                String?               @unique
  phone                String?
  logo                 String?
  address              String?
  city                 String?
  state                String?
  country              String?
  postalCode           String?
  taxNumber            String?
  registrationNo       String?
  settings             BusinessSettings?
  receiptSettings      ReceiptSettings?
  taxSettings          TaxSettings?
  notificationSettings NotificationSettings?
  currency             String                @default("USD")
  timezone             String                @default("UTC")
  status               BusinessStatus        @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches              Branch[]
  users                 User[]
  roles                 Role[]
  permissions           Permission[]
  categories            Category[]
  brands                Brand[]
  units                 Unit[]
  products              Product[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  stockAdjustments      StockAdjustment[]
  customers             Customer[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  goodsSupplied         GoodsSupplied[]
  goodsDisbursements    GoodsDisbursement[]
  sales                 Sale[]
  payments              Payment[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  cashRegisters         CashRegister[]
  dailyBalances         DailyBalance[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  employees             Employee[]

  @@index([name])
}

//////////////////////////////////////////////////////
// BRANCH
//////////////////////////////////////////////////////

model Branch {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  code    String  @unique
  phone   String?
  email   String?
  address String?
  city    String?
  state   String?
  country String?

  status BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([businessId])
  @@index([name])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  roleId String? @db.Uuid
  role   Role?   @relation(fields: [roleId], references: [id])

  firstName String
  lastName  String

  email String? @unique
  phone String?

  username String @unique
  password String

  profileImage String?
  employee     Employee?

  status UserStatus @default(ACTIVE)

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  sales               Sale[]
  payments            Payment[]
  creditPayments      CreditPayment[]
  auditLogs           AuditLog[]
  expenses            Expense[]
  cashRegisters       CashRegister[]
  notifications       Notification[]

  @@index([businessId])
  @@index([branchId])
  @@index([roleId])
  @@index([username])
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId])
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  module      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId])
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

//////////////////////////////////////////////////////
// USER SESSION
//////////////////////////////////////////////////////

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String

  ipAddress  String?
  deviceName String?
  deviceId   String?
  deviceType String?

  userAgent String?

  expiresAt DateTime

  status SessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

//////////////////////////////////////////////////////
// PASSWORD RESET TOKEN
//////////////////////////////////////////////////////

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String
  channel     PasswordResetChannel
  destination String

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

//////////////////////////////////////////////////////
// PLACEHOLDER (TO BE IMPLEMENTED IN PART 5)
//////////////////////////////////////////////////////

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([businessId, name])
  @@index([supplierId])
  @@index([businessId])
  @@index([name])
}

//////////////////////////////////////////////////////
// BRAND
//////////////////////////////////////////////////////

model Brand {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([name])
}

//////////////////////////////////////////////////////
// UNIT
//////////////////////////////////////////////////////

model Unit {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  symbol      String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([businessId, symbol])
  @@index([businessId])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String? @db.Uuid
  brand   Brand?  @relation(fields: [brandId], references: [id])

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  unitId String @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id])

  name    String
  sku     String
  barcode String?

  description String?

  purchasePrice    Decimal  @db.Decimal(12, 2)
  sellingPrice     Decimal  @db.Decimal(12, 2)
  baseSellingPrice Decimal @db.Decimal(12, 2)
  wholesalePrice   Decimal? @db.Decimal(12, 2)

  minimumStock Int  @default(0)
  maximumStock Int?

  imageUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images                 ProductImage[]
  barcodes               ProductBarcode[]
  inventory              Inventory?
  inventoryTransactions  InventoryTransaction[]
  stockAdjustments       StockAdjustment[]
  purchaseOrderItems     PurchaseOrderItem[]
  goodsSuppliedItems     GoodsSuppliedItem[]
  goodsDisbursementItems GoodsDisbursementItem[]
  saleItems              SaleItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([unitId])
  @@index([barcode])
  @@index([sku])
  @@index([name])
}

//////////////////////////////////////////////////////
// PRODUCT IMAGE
//////////////////////////////////////////////////////

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl String

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

//////////////////////////////////////////////////////
// PRODUCT BARCODE
//////////////////////////////////////////////////////

model ProductBarcode {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  barcode String @unique

  barcodeType String? // EAN13, CODE128, QR, etc.

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([barcode])
}

//////////////////////////////////////////////////////
// INVENTORY
//////////////////////////////////////////////////////

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOnHand    Int @default(0)
  quantityReserved  Int @default(0)
  quantityAvailable Int @default(0)

  reorderLevel    Int  @default(0)
  reorderQuantity Int?

  averageCost Decimal? @db.Decimal(12, 2)

  lastStockUpdate DateTime?

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]
  adjustments  StockAdjustment[]

  @@index([businessId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// INVENTORY TRANSACTION
//////////////////////////////////////////////////////

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  DAMAGE
  EXPIRED
  TRANSFER
}

model InventoryTransaction {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  transactionType InventoryTransactionType

  quantity Int

  quantityBefore Int

  quantityAfter Int

  unitCost Decimal? @db.Decimal(12, 2)

  referenceNumber String?

  remarks String?

  transactionDate DateTime @default(now())

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([inventoryId])
  @@index([productId])
  @@index([transactionType])
  @@index([transactionDate])
}

//////////////////////////////////////////////////////
// STOCK ADJUSTMENT
//////////////////////////////////////////////////////

enum AdjustmentType {
  INCREASE
  DECREASE
}

model StockAdjustment {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  adjustmentType AdjustmentType

  quantity Int

  previousQuantity Int

  newQuantity Int

  reason String

  approvedBy String?

  adjustmentDate DateTime @default(now())

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([inventoryId])
  @@index([productId])
  @@index([adjustmentDate])
}

//////////////////////////////////////////////////////
// CUSTOMER
//////////////////////////////////////////////////////

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerCode String?

  firstName String
  lastName  String?

  companyName String?

  email String?
  phone String

  address String?
  city    String?
  state   String?
  country String?

  creditLimit        Decimal @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  status CustomerStatus @default(ACTIVE)

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  payments       Payment[]
  creditPayments CreditPayment[]
  creditSales    CreditSale[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([phone])
  @@index([firstName])
  @@index([companyName])
}

//////////////////////////////////////////////////////
// SUPPLIER
//////////////////////////////////////////////////////

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierCode String?

  companyName String

  contactPerson String?

  email String?
  phone String

  address String?
  city    String?
  state   String?
  country String?

  taxNumber String?

  outstandingBalance Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  status SupplierStatus @default(ACTIVE)

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories     Category[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  goodsSupplied  GoodsSupplied[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([companyName])
  @@index([phone])
}

//////////////////////////////////////////////////////
// PURCHASE ORDER
//////////////////////////////////////////////////////

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  orderNumber String

  orderDate DateTime @default(now())

  expectedDate DateTime?

  subtotal Decimal @default(0) @db.Decimal(12, 2)

  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  status PurchaseOrderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseOrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([supplierId])
}

//////////////////////////////////////////////////////
// PURCHASE ORDER ITEM
//////////////////////////////////////////////////////

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid

  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  totalPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// GOODS SUPPLIED
//////////////////////////////////////////////////////

enum GoodsSupplyStatus {
  COMPLETED
}

model GoodsSupplied {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  supplyNumber String

  suppliedDate DateTime @default(now())

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GoodsSuppliedItem[]

  @@unique([businessId, supplyNumber])
  @@index([businessId])
  @@index([supplierId])
}

//////////////////////////////////////////////////////
// GOODS SUPPLIED ITEM
//////////////////////////////////////////////////////

model GoodsSuppliedItem {
  id String @id @default(uuid()) @db.Uuid

  goodsSuppliedId String        @db.Uuid
  goodsSupplied   GoodsSupplied @relation(fields: [goodsSuppliedId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitCost Decimal @db.Decimal(12, 2)

  totalCost Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsSuppliedId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// GOODS DISBURSEMENT
//////////////////////////////////////////////////////

model GoodsDisbursement {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  disbursementNumber String

  disbursementDate DateTime @default(now())

  destination String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GoodsDisbursementItem[]

  @@unique([businessId, disbursementNumber])
  @@index([businessId])
  @@index([employeeId])
}

//////////////////////////////////////////////////////
// GOODS DISBURSEMENT ITEM
//////////////////////////////////////////////////////

model GoodsDisbursementItem {
  id String @id @default(uuid()) @db.Uuid

  goodsDisbursementId String            @db.Uuid
  goodsDisbursement   GoodsDisbursement @relation(fields: [goodsDisbursementId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsDisbursementId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// SALES
//////////////////////////////////////////////////////

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Sale {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  saleNumber String

  subtotal Decimal @default(0) @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  amountPaid Decimal @default(0) @db.Decimal(12, 2)

  balanceDue Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(UNPAID)

  status SaleStatus @default(COMPLETED)

  remarks String?

  idempotencyKey String?

  saleDate DateTime @default(now())

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?
  receipt     Receipt?

  creditSale CreditSale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]

  payments Payment[]

  @@unique([businessId, saleNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([userId])
  @@index([saleDate])
}

//////////////////////////////////////////////////////
// SALE ITEM
//////////////////////////////////////////////////////

model SaleItem {
  id String @id @default(uuid()) @db.Uuid

  saleId String @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

enum PaymentMethod {
  CASH
  CREDIT
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  saleId String @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  paymentMethod PaymentMethod

  amount Decimal @db.Decimal(12, 2)

  referenceNumber String?

  paymentDate DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([saleId])
  @@index([customerId])
  @@index([userId])
  @@index([paymentDate])
}

//////////////////////////////////////////////////////
// RECEIPT
//////////////////////////////////////////////////////

model Receipt {
  id String @id @default(uuid()) @db.Uuid

  saleId String @unique @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  receiptNumber String

  printed Boolean @default(false)

  printedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items ReceiptItem[]

  @@index([receiptNumber])
}

//////////////////////////////////////////////////////
// RECEIPT ITEM
//////////////////////////////////////////////////////

model ReceiptItem {
  id String @id @default(uuid()) @db.Uuid

  receiptId String  @db.Uuid
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  productName String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([receiptId])
}

//////////////////////////////////////////////////////
// CREDIT SALE
//////////////////////////////////////////////////////

enum CreditSaleStatus {
  ACTIVE
  PARTIALLY_PAID
  PAID
  DEFAULTED
}

model CreditSale {
  id String @id @default(uuid()) @db.Uuid

  saleId String @unique @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  totalCredit Decimal @db.Decimal(12, 2)

  amountPaid Decimal @default(0) @db.Decimal(12, 2)

  balance Decimal @db.Decimal(12, 2)

  dueDate DateTime?

  status CreditSaleStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  payments CreditPayment[]

  @@index([customerId])
  @@index([status])
}

//////////////////////////////////////////////////////
// CREDIT PAYMENT
//////////////////////////////////////////////////////

model CreditPayment {
  id String @id @default(uuid()) @db.Uuid

  creditSaleId String     @db.Uuid
  creditSale   CreditSale @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  paymentMethod PaymentMethod

  amount Decimal @db.Decimal(12, 2)

  referenceNumber String?

  paymentDate DateTime @default(now())

  notes String?

  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([creditSaleId])
  @@index([customerId])
  @@index([userId])
  @@index([paymentDate])
}

//////////////////////////////////////////////////////
// EXPENSE CATEGORY
//////////////////////////////////////////////////////

model ExpenseCategory {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([businessId, name])
  @@index([businessId])
}

//////////////////////////////////////////////////////
// EXPENSE
//////////////////////////////////////////////////////

model Expense {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String          @db.Uuid
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  expenseNumber String

  title String

  description String?

  amount Decimal @db.Decimal(12, 2)

  expenseDate DateTime @default(now())

  receiptNumber String?

  vendor String?

  paymentMethod PaymentMethod

  isSynced    Boolean   @default(true)
  syncVersion Int       @default(1)
  deviceId    String?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, expenseNumber])
  @@index([businessId])
  @@index([categoryId])
  @@index([userId])
  @@index([expenseDate])
}

//////////////////////////////////////////////////////
// CASH REGISTER
//////////////////////////////////////////////////////

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  openingBalance Decimal @default(0) @db.Decimal(12, 2)

  closingBalance Decimal? @db.Decimal(12, 2)

  expectedBalance Decimal? @db.Decimal(12, 2)

  actualBalance Decimal? @db.Decimal(12, 2)

  status CashRegisterStatus @default(OPEN)

  openedAt DateTime @default(now())

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CashRegisterTransaction[]

  @@index([businessId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// CASH REGISTER TRANSACTION
//////////////////////////////////////////////////////

enum CashTransactionType {
  SALE
  CREDIT_PAYMENT
  EXPENSE
  CASH_IN
  CASH_OUT
  OPENING_BALANCE
  CLOSING_BALANCE
}

model CashRegisterTransaction {
  id String @id @default(uuid()) @db.Uuid

  cashRegisterId String       @db.Uuid
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  transactionType CashTransactionType

  amount Decimal @db.Decimal(12, 2)

  reference String?

  description String?

  transactionDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashRegisterId])
  @@index([transactionDate])
}

//////////////////////////////////////////////////////
// DAILY BALANCE
//////////////////////////////////////////////////////

model DailyBalance {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  balanceDate DateTime

  openingBalance Decimal @default(0) @db.Decimal(12, 2)

  totalSales Decimal @default(0) @db.Decimal(12, 2)

  totalExpenses Decimal @default(0) @db.Decimal(12, 2)

  totalCreditReceived Decimal @default(0) @db.Decimal(12, 2)

  closingBalance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, balanceDate])
  @@index([businessId])
  @@index([balanceDate])
}

//////////////////////////////////////////////////////
// BUSINESS SETTINGS
//////////////////////////////////////////////////////

model BusinessSettings {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  currency String @default("USD")
  timezone String @default("UTC")
  language String @default("en")

  allowNegativeStock Boolean @default(false)
  allowCreditSales   Boolean @default(true)
  enableOfflineMode  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// RECEIPT SETTINGS
//////////////////////////////////////////////////////

model ReceiptSettings {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  businessName String?

  businessAddress String?

  businessPhone String?

  footerMessage String?

  showLogo Boolean @default(true)

  autoPrint Boolean @default(false)

  paperWidth String @default("80mm")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TAX SETTINGS
//////////////////////////////////////////////////////

model TaxSettings {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  taxName String

  taxPercentage Decimal @default(0) @db.Decimal(5, 2)

  taxNumber String?

  taxEnabled Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// NOTIFICATION SETTINGS
//////////////////////////////////////////////////////

model NotificationSettings {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  lowStockAlert Boolean @default(true)

  lowStockLevel Int @default(5)

  dailySalesSummary Boolean @default(true)

  weeklySalesSummary Boolean @default(true)

  monthlySalesSummary Boolean @default(true)

  pushNotifications Boolean @default(true)

  emailNotifications Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([userId])
  @@index([isRead])
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  SALE
  PAYMENT
  EXPENSE
  STOCK_SUPPLIED
  STOCK_DISBURSED
  STOCK_ADJUSTMENT
  ROLE_CHANGE
  PERMISSION_CHANGE
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET
  TOKEN_REFRESH
  SESSION_REVOKED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  STOCK_IN
  STOCK_OUT
  SALE_CREATED
  SALE_CANCELLED
  PAYMENT_CREATED
  CREDIT_PAYMENT_CREATED
  BUSINESS_SETTINGS_UPDATED
  TAX_SETTINGS_UPDATED
  RECEIPT_SETTINGS_UPDATED
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  action AuditAction

  entity String

  entityId String?

  description String?

  ipAddress String?

  deviceId String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// EMPLOYEE
//////////////////////////////////////////////////////

model Employee {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeCode String

  firstName String
  lastName  String

  gender String?

  dateOfBirth DateTime?

  phone String?

  email String?

  address String?

  city String?

  state String?

  country String?

  emergencyContactName String?

  emergencyContactPhone String?

  department String?

  designation String?

  hireDate DateTime?

  salary Decimal? @db.Decimal(12, 2)

  profileImage String?

  lastLogin DateTime?

  status EmployeeStatus @default(ACTIVE)

  canLogin Boolean @default(true)

  canSell Boolean @default(true)

  canManageStock Boolean @default(false)

  canManageExpenses Boolean @default(false)

  canPrintReceipt Boolean @default(true)

  notes String?

  isSynced Boolean @default(true)

  syncVersion Int @default(1)

  deviceId String?

  deletedAt DateTime?

  goodsDisbursements GoodsDisbursement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([businessId, employeeCode])
  @@index([businessId])
  @@index([userId])
  @@index([employeeCode])
  @@index([status])
}

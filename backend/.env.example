NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12
SEED_ADMIN_PASSWORD=replace_with_a_strong_initial_admin_password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
PASSWORD_RESET_FROM_EMAIL=Smart POS <password-reset@your-verified-domain.example>
PASSWORD_RESET_SMS_WEBHOOK_URL=

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5
REFRESH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

CORS_ORIGINS=https://your-production-mobile-or-web-origin.example
REQUEST_BODY_LIMIT=1mb
SWAGGER_ENABLED=false
TRUST_PROXY=true
